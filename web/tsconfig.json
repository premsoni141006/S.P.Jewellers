{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["web-bluetooth", "vite/client"],
    "paths": { "@shared": ["../shared/src/index.ts"], "@shared/*": ["../shared/src/*"] }
  },
  "include": ["src", "../shared/src"]
}
